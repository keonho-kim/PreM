{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": false
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.{js,cjs,mjs,jsx,ts,tsx,json,jsonc,css}",
      "!!**/node_modules",
      "!!target",
      "!!frontend/dist",
      "!!coverage",
      "!!data",
      "!!.hallmark",
      "!!runtime",
      "!!release",
      "!!tests/.artifacts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "linter": {
      "enabled": false
    }
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "includes": ["frontend/**/*.ts", "frontend/**/*.tsx", "scripts/**/*.mjs"],
    "rules": {
      "correctness": {
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "style": {
        "useExportType": "error",
        "useImportType": "error"
      },
      "preset": "recommended",
      "a11y": "error"
    }
  }
}
