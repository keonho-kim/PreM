# Purpose: Pin the Python dependency consumed by PPT Master's native exporter.
# Pattern: Build-time lock and install; application runtime never installs packages.
# Usage: uv pip compile --generate-hashes --python <bundled-python> scripts/runtime/requirements.in -o scripts/runtime/requirements.lock
# Related: documents.mjs, backend/tools/presentation-render.py.
python-pptx==1.0.2
