{
  "name": "prem",
  "version": "2026.11.18",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": ">=12.16.1 <13"
  },
  "scripts": {
    "runtime:install": "node scripts/runtime/documents.mjs install",
    "dev": "node scripts/dev.mjs",
    "dev:backend": "node scripts/dev.mjs --backend-only",
    "dev:frontend": "pnpm --filter @prem/frontend dev",
    "build": "./scripts/build.sh",
    "release:package": "python3 scripts/release/package.py",
    "release:verify": "python3 scripts/release/verify.py",
    "check": "bash scripts/quality/check.sh full",
    "lint": "biome lint frontend scripts --error-on-warnings",
    "typecheck": "pnpm --filter @prem/frontend typecheck",
    "test": "pnpm test:rust && pnpm --filter @prem/frontend test",
    "smoke": "python3 scripts/test/smoke.py",
    "format": "biome format --write . && prettier --write \"**/*.{md,html,yml,yaml}\" && cargo fmt --all",
    "format:check": "biome format . && prettier --check \"**/*.{md,html,yml,yaml}\" && cargo fmt --all -- --check",
    "tokens": "node scripts/generate-design-tokens.mjs",
    "tokens:check": "node scripts/generate-design-tokens.mjs --check",
    "tools:install": "node scripts/quality/rust-tools.mjs install",
    "tools:check": "node scripts/quality/rust-tools.mjs check",
    "check:deps": "bash scripts/quality/check.sh deps",
    "test:rust": "pnpm --filter @prem/frontend build && cargo nextest run --workspace --all-features --locked --no-fail-fast && cargo test --workspace --all-features --locked --doc",
    "coverage": "pnpm coverage:frontend && pnpm coverage:rust",
    "coverage:frontend": "pnpm --filter @prem/frontend coverage",
    "coverage:rust": "pnpm --filter @prem/frontend build && node scripts/test/coverage.mjs",
    "fixtures:parsing": "uv run tests/helpers/parsing-fixtures.py",
    "fixtures:presentation": "node tests/helpers/presentation-public.mjs",
    "test:presentation:live": "node tests/e2e/presentation-live.cjs",
    "audit:parsing": "node tests/helpers/parsing-audit.mjs",
    "test:e2e": "node scripts/test/e2e.mjs",
    "check:structure": "node scripts/quality/source-size.mjs && pnpm --filter @prem/frontend check:architecture",
    "check:core": "bash scripts/quality/check.sh core",
    "check:versions": "node scripts/quality/versions.mjs",
    "backup": "python3 scripts/storage-backup.py backup",
    "restore": "python3 scripts/storage-backup.py restore"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "prettier": "3.10.1"
  }
}
